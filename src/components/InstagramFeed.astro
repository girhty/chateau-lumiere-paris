---
import Card from './Card.astro';

interface Post {
  caption: string;
  image_url: string;
  likes: number;
}

interface Props {
  username?: string;
  name?: string;
  biography?: string;
  followersCount?: number;
  posts?: Post[];
}

const {
  username = 'chateaulumiere_paris',
  name = 'Château Lumière Paris',
  biography = 'Where timeless Parisian heritage meets contemporary luxury. 📍 75005 Paris',
  followersCount = 48200,
  posts = [
    {
      caption: 'Golden hour over the Seine from our Suite Royale 🌅 #ParisLuxury #ChateauLumiere',
      image_url:
        'https://images.unsplash.com/photo-1502602898657-3e91760cbb34?w=800&auto=format&fit=crop&q=80',
      likes: 1420,
    },
    {
      caption: 'Artisanal breakfast served in our private winter garden 🥐☕ #ParisianMorning',
      image_url:
        'https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?w=800&auto=format&fit=crop&q=80',
      likes: 2180,
    },
    {
      caption: 'Evening degustation by Chef Laurent. Reserve your table for this weekend ✨',
      image_url:
        'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=800&auto=format&fit=crop&q=80',
      likes: 980,
    },
  ],
} = Astro.props;

const profileUrl = `https://www.instagram.com/${username}/`;

const formatCount = (n: number) =>
  n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1).replace('.0', '')}k` : `${n}`;
---

<section
  id="gallery"
  class="relative border-t border-gold/10 bg-ink-900 py-24 sm:py-32"
  aria-labelledby="gallery-heading"
>
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <!-- Profile header -->
    <div
      class="flex flex-col gap-8 border-b border-gold/10 pb-10 sm:flex-row sm:items-end sm:justify-between"
      data-reveal
    >
      <div class="flex items-start gap-5">
        <a
          href={profileUrl}
          class="group relative flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-gradient-to-tr from-gold-dark via-gold to-gold-light p-[2px] transition duration-300 hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
          rel="noopener noreferrer"
          target="_blank"
          aria-label={`${name} on Instagram`}
        >
          <span class="flex h-full w-full items-center justify-center rounded-full bg-ink-800 font-display text-2xl text-gold">
            CL
          </span>
        </a>

        <div>
          <p class="mb-3 flex items-center gap-3 text-[0.62rem] font-medium uppercase tracking-widest2 text-gold/80 sm:text-xs">
            <span class="h-px w-10 bg-gold/50" aria-hidden="true"></span>
            Follow the Château
          </p>
          <h2 id="gallery-heading" class="font-display text-4xl leading-tight text-cream sm:text-5xl">
            @{username}
          </h2>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-cream-muted">{biography}</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-gold/25 bg-ink-800/80 px-4 py-2 text-sm text-cream"
        >
          <strong class="font-semibold tabular-nums">{followersCount.toLocaleString('en-US')}</strong>
          <span class="text-cream-dim">followers</span>
        </span>
        <a
          href={profileUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-gold-light via-gold to-gold-dark px-6 py-3 text-xs font-semibold uppercase tracking-[0.18em] text-ink-900 transition duration-300 hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.23 1 .5 1.4.95.45.44.72.84.95 1.4.17.44.37 1.05.42 2.24.06 1.28.07 1.66.07 4.9s0 3.6-.07 4.9c-.05 1.18-.25 1.79-.42 2.23-.23.57-.5.97-.95 1.41-.44.45-.84.72-1.4.95-.44.17-1.05.37-2.24.42-1.28.07-1.66.07-4.9.07s-3.6 0-4.9-.07c-1.18-.05-1.79-.25-2.23-.42a3.8 3.8 0 0 1-1.41-.95 3.8 3.8 0 0 1-.95-1.4c-.17-.45-.37-1.06-.42-2.24C2.21 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.05-1.18.25-1.79.42-2.23.23-.57.5-.97.95-1.41.44-.45.84-.72 1.4-.95.45-.17 1.06-.37 2.24-.42C8.4 2.21 8.8 2.2 12 2.2Zm0 1.8c-3.14 0-3.5 0-4.74.07-1.14.05-1.76.24-2.17.4-.55.21-.94.47-1.35.88-.4.4-.66.8-.87 1.35-.16.4-.35 1.03-.4 2.17C2.4 8.5 2.4 8.86 2.4 12s0 3.5.07 4.74c.05 1.14.24 1.76.4 2.17.21.55.47.94.87 1.35.41.4.8.66 1.35.87.41.16 1.03.35 2.17.4C8.5 21.6 8.86 21.6 12 21.6s3.5 0 4.74-.07c1.14-.05 1.76-.24 2.17-.4.55-.21.94-.47 1.35-.87.4-.41.66-.8.87-1.35.16-.41.35-1.03.4-2.17.07-1.24.07-1.6.07-4.74s0-3.5-.07-4.74c-.05-1.14-.24-1.76-.4-2.17a3.6 3.6 0 0 0-.87-1.35 3.6 3.6 0 0 0-1.35-.87c-.41-.16-1.03-.35-2.17-.4C15.5 4 15.14 4 12 4Zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 8.08a3.18 3.18 0 1 0 0-6.36 3.18 3.18 0 0 0 0 6.36Zm6.24-8.28a1.14 1.14 0 1 1-2.29 0 1.14 1.14 0 0 1 2.29 0Z"/>
          </svg>
          Follow
        </a>
      </div>
    </div>

    <!-- Post grid -->
    <ul class="mt-12 grid list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post, i) => (
          <Card
            as="li"
            class="overflow-hidden"
            data-reveal
            style={`transition-delay:${i * 100}ms`}
          >
            <a
              href={profileUrl}
              rel="noopener noreferrer"
              target="_blank"
              class="group/post block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
              aria-label={`Instagram post: ${post.caption}`}
            >
              <div class="relative aspect-[4/5] overflow-hidden">
                <img
                  src={post.image_url}
                  alt={post.caption}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition duration-[900ms] ease-[cubic-bezier(.22,1,.36,1)] group-hover/post:scale-[1.07]"
                />
                <div
                  class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/45 to-transparent opacity-85 transition-opacity duration-500 group-hover/post:opacity-95"
                  aria-hidden="true"
                >
                </div>

                <!-- Hover metrics -->
                <div
                  class="absolute inset-x-0 top-0 flex translate-y-[-8px] items-center justify-end gap-4 p-5 opacity-0 transition duration-500 group-hover/post:translate-y-0 group-hover/post:opacity-100"
                  aria-hidden="true"
                >
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-ink-900/75 px-3 py-1.5 text-xs font-semibold text-cream backdrop-blur">
                    <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 text-gold" fill="currentColor">
                      <path d="M12 21s-7.5-4.6-9.3-9A5.3 5.3 0 0 1 12 6.4 5.3 5.3 0 0 1 21.3 12c-1.8 4.4-9.3 9-9.3 9Z"/>
                    </svg>
                    {formatCount(post.likes)}
                  </span>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-ink-900/75 px-3 py-1.5 text-xs font-semibold text-cream backdrop-blur">
                    <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 text-gold" fill="currentColor">
                      <path d="M21 12a8 8 0 0 1-11.6 7.1L4 21l1.9-5.4A8 8 0 1 1 21 12Z"/>
                    </svg>
                    {Math.round(post.likes / 18)}
                  </span>
                </div>

                <!-- Caption -->
                <div class="absolute inset-x-0 bottom-0 p-5">
                  <p class="line-clamp-3 text-sm leading-relaxed text-cream/95">
                    {post.caption}
                  </p>
                  <p class="mt-3 inline-flex items-center gap-2 text-[0.6rem] uppercase tracking-widest2 text-gold/85">
                    View on Instagram
                    <span aria-hidden="true" class="transition-transform duration-300 group-hover/post:translate-x-1">→</span>
                  </p>
                </div>
              </div>
            </a>
          </Card>
        ))
      }
    </ul>

    <p class="mt-10 text-center text-xs uppercase tracking-widest2 text-cream-dim" data-reveal>
      Tag <span class="text-gold">@chateaulumiere_paris</span> for a chance to be featured
    </p>
  </div>
</section>