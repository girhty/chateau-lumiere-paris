---
import Card from './Card.astro';

interface Props {
  name?: string;
  address?: string;
  phone?: string;
  hours?: string[];
}

const {
  name = 'Château Lumière Boutique Hotel',
  address = '45 Boulevard Saint-Germain, 75005 Paris, France',
  phone = '+33 1 42 68 55 00',
  hours = [
    'Monday: 24 Hours',
    'Tuesday: 24 Hours',
    'Wednesday: 24 Hours',
    'Thursday: 24 Hours',
    'Friday: 24 Hours',
    'Saturday: 24 Hours',
    'Sunday: 24 Hours',
  ],
} = Astro.props;

const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(address)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
const telHref = `tel:${phone.replace(/[^+\d]/g, '')}`;
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
---

<section
  id="contact"
  class="relative border-t border-gold/10 bg-ink-800 py-24 sm:py-32"
  aria-labelledby="contact-heading"
>
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <header class="max-w-2xl" data-reveal>
      <p class="mb-5 flex items-center gap-3 text-[0.62rem] font-medium uppercase tracking-widest2 text-gold/80 sm:text-xs">
        <span class="h-px w-10 bg-gold/50" aria-hidden="true"></span>
        Find Us
      </p>
      <h2 id="contact-heading" class="font-display text-4xl leading-tight text-cream sm:text-5xl">
        In the heart of the <span class="gold-text italic">Left Bank</span>.
      </h2>
      <p class="mt-6 text-base leading-relaxed text-cream-muted">
        Two minutes from the Seine, a short stroll to Notre-Dame and the Louvre. Our
        concierge is at your service around the clock.
      </p>
    </header>

    <div class="mt-14 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)]">
      <!-- Details -->
      <div class="grid gap-6">
        <Card class="p-7" data-reveal>
          <h3 class="flex items-center gap-3 font-display text-2xl text-cream">
            <span class="flex h-10 w-10 items-center justify-center rounded-full border border-gold/30 bg-gold/[0.07] text-gold" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
                <path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/>
              </svg>
            </span>
            Address
          </h3>
          <address class="mt-4 not-italic text-sm leading-relaxed text-cream-muted">
            {name}<br />
            {address}
          </address>
          <a
            href={mapsHref}
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-5 inline-flex items-center gap-2 text-sm font-medium text-gold transition hover:text-gold-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
          >
            Get directions
            <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        </Card>

        <Card class="p-7" data-reveal style="transition-delay:90ms">
          <h3 class="flex items-center gap-3 font-display text-2xl text-cream">
            <span class="flex h-10 w-10 items-center justify-center rounded-full border border-gold/30 bg-gold/[0.07] text-gold" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
                <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"/>
              </svg>
            </span>
            Reservations
          </h3>
          <p class="mt-4 text-sm leading-relaxed text-cream-muted">
            Call our 24-hour front desk or write to
            <a
              href="mailto:reservations@chateau-lumiere-paris.com"
              class="text-gold underline decoration-gold/40 underline-offset-4 transition hover:text-gold-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
            >reservations@chateau-lumiere-paris.com</a>.
          </p>
          <a
            href={telHref}
            class="mt-5 inline-flex items-center gap-2 rounded-full border border-gold/35 px-5 py-3 text-sm font-semibold tracking-wide text-cream transition duration-300 hover:border-gold hover:bg-gold/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4 text-gold" fill="currentColor" aria-hidden="true">
              <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"/>
            </svg>
            {phone}
          </a>
        </Card>

        <Card class="p-7" data-reveal style="transition-delay:180ms">
          <h3 class="flex items-center gap-3 font-display text-2xl text-cream">
            <span class="flex h-10 w-10 items-center justify-center rounded-full border border-gold/30 bg-gold/[0.07] text-gold" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 5v5.6l4.2 2.5-.8 1.3L11 13.6V7h2Z"/>
              </svg>
            </span>
            Opening Hours
          </h3>
          <p class="mt-3 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest2 text-emerald-300/90">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
            Open 24 hours · Reception always staffed
          </p>
          <ul class="mt-4 list-none space-y-1.5 p-0 text-sm">
            {
              hours.map((line) => (
                <li class="flex items-center justify-between gap-4 border-b border-white/[0.05] pb-1.5 text-cream-muted last:border-0">
                  <span>{line.split(':')[0]}</span>
                  <span class="tabular-nums text-cream/90">{line.split(':').slice(1).join(':').trim()}</span>
                </li>
              ))
            }
          </ul>
        </Card>
      </div>

      <!-- Map -->
      <Card hover={false} class="min-h-[26rem] overflow-hidden p-0" data-reveal style="transition-delay:120ms">
        <div class="h-full w-full">
          <iframe
            title={`Map showing the location of ${name} at ${address}`}
            src={mapSrc}
            class="h-full min-h-[26rem] w-full border-0 grayscale-[35%] contrast-[1.05]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </Card>
    </div>
  </div>
</section>