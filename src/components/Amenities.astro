---
import Card from './Card.astro';

const amenities = [
  {
    title: 'Le Jardin d’Hiver',
    kicker: 'Gastronomy',
    body:
      'A Michelin-recommended table led by Chef Laurent Deveraux. Seasonal French produce, a 400-label cellar, and a glass-roofed winter garden.',
    icon: 'plate',
  },
  {
    title: 'Spa Lumière',
    kicker: 'Wellness',
    body:
      'Candlelit hammam, hôtel-de-ville stone plunge pool and signature gold-leaf facials by our resident maître de beauté.',
    icon: 'spa',
  },
  {
    title: 'Rooftop Belvédère',
    kicker: 'Evenings',
    body:
      'Unobstructed views over the Seine and Notre-Dame. Rare vintages, live jazz quartets and Parisian sunsets until late.',
    icon: 'moon',
  },
  {
    title: 'Concierge 24/7',
    kicker: 'Service',
    body:
      'Private museum openings, chauffeured Citroën DS tours, and same-hour reservations at the city’s most sought-after tables.',
    icon: 'bell',
  },
];

const icons = {
  plate: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 2.5a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13Zm0 3.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z',
  spa: 'M12 21c0-5 2.5-9.5 8-11-1 5.5-4.4 9.6-8 11Zm0 0c0-5-2.5-9.5-8-11 1 5.5 4.4 9.6 8 11Zm0-9.5c1.6-2.2 2.4-4.7 2.4-7.5-1.6 1.6-2.4 3.7-2.4 7.5Z',
  moon: 'M20.5 14.4A8.6 8.6 0 0 1 9.6 3.5a8.9 8.9 0 1 0 10.9 10.9Z',
  bell: 'M12 3a6 6 0 0 0-6 6v3.2L4.5 15.5a.9.9 0 0 0 .8 1.4h13.4a.9.9 0 0 0 .8-1.4L18 12.2V9a6 6 0 0 0-6-6Zm-2 15.2a2 2 0 0 0 4 0h-4Z',
};
---

<section id="experience" class="relative border-t border-gold/10 bg-ink-900 py-24 sm:py-32" aria-labelledby="experience-heading">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <header class="max-w-2xl" data-reveal>
      <p class="mb-5 flex items-center gap-3 text-[0.62rem] font-medium uppercase tracking-widest2 text-gold/80 sm:text-xs">
        <span class="h-px w-10 bg-gold/50" aria-hidden="true"></span>
        The Lumière Experience
      </p>
      <h2 id="experience-heading" class="font-display text-4xl leading-tight text-cream sm:text-5xl lg:text-[3.4rem]">
        Every hour, <span class="gold-text italic">considered</span>.
      </h2>
      <p class="mt-6 text-base leading-relaxed text-cream-muted">
        Four signatures that define a stay at Château Lumière — from the first breakfast
        in the winter garden to the last glass on the rooftop.
      </p>
    </header>

    <ul class="mt-16 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
      {
        amenities.map((item, i) => (
          <Card
            as="li"
            class="p-7"
            data-reveal
            style={`transition-delay:${i * 90}ms`}
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-full border border-gold/30 bg-gold/[0.07] text-gold transition duration-500 group-hover:border-gold/60 group-hover:bg-gold/15">
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
                <path d={icons[item.icon]} />
              </svg>
            </div>

            <p class="mt-6 text-[0.6rem] font-semibold uppercase tracking-widest2 text-gold/75">
              {item.kicker}
            </p>
            <h3 class="mt-2 font-display text-2xl text-cream">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-cream-muted">{item.body}</p>
          </Card>
        ))
      }
    </ul>
  </div>
</section>